{
  "name": "sleep-rings",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "web": "vite build && vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "web:tunnel": "cloudflared tunnel --url http://127.0.0.1:4173",
    "deploy:web": "vite build && npx -y wrangler@4.164.0 deploy",
    "build:ios": "vite build && npx cap sync ios",
    "release": "commit-and-tag-version",
    "build:android": "vite build && npx cap sync android && cd android && ./gradlew bundleRelease assembleRelease"
  },
  "dependencies": {
    "@capacitor-community/admob": "8.1.0",
    "@capacitor/android": "8.4.3",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.4.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.4.3",
    "@capacitor/local-notifications": "8.3.1",
    "@capawesome-team/capacitor-android-foreground-service": "8.1.0",
    "@capawesome/capacitor-app-shortcuts": "8.0.3",
    "@capgo/capacitor-app-intents": "8.3.0",
    "@capgo/capacitor-widget-kit": "8.2.2",
    "@revenuecat/purchases-capacitor": "13.4.0",
    "i18next": "^26.3.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.10",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.4.3",
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "commit-and-tag-version": "13.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "16.5.0",
    "jsdom": "^29.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
