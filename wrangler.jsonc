// Static web build on Cloudflare (Workers static assets — what `pages` deploys to since wrangler 4.16x).
// Deploy: npm run deploy:web → https://sleep-rings.hyuckjin.workers.dev
// No vite plugin on purpose: dist/ must stay a plain static build because Capacitor packages it too.
{
  "name": "sleep-rings",
  "compatibility_date": "2026-11-17",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
